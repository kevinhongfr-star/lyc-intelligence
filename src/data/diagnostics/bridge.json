  "dimensions": [
    {
      "key": "d1_mandate_clarity",
      "name": "Mandate Clarity",
      "description": "Measures the leader's specific, detailed understanding of what their mandate actually requires.",
      "low_label": "Developing",
      "high_label": "Mastery",
      "weight": 1.0,
      "sort_order": 1
    },
    {
      "key": "d2_stakeholder_relationship_building",
      "name": "Stakeholder Relationship Building",
      "description": "Measures the leader's ability to identify, invest in, and maintain key stakeholder relationships in high-context APAC environments.",
      "low_label": "Developing",
      "high_label": "Mastery",
      "weight": 1.0,
      "sort_order": 2
    },
    {
      "key": "d3_communication_alignment",
      "name": "Communication Alignment",
      "description": "Measures the leader's ability to adapt their natural communication style for APAC contexts.",
      "low_label": "Developing",
      "high_label": "Mastery",
      "weight": 1.0,
      "sort_order": 3
    },
    {
      "key": "d4_pressure_resilience",
      "name": "Pressure Resilience",
      "description": "Measures the leader's ability to sustain decision quality and mandate focus under simultaneous pressures.",
      "low_label": "Developing",
      "high_label": "Mastery",
      "weight": 1.0,
      "sort_order": 4
    },
    {
      "key": "d5_long_game_thinking",
      "name": "Long-Game Thinking",
      "description": "Measures the leader's comfort with investing in relationships and trust-building over multi-year timelines.",
      "low_label": "Developing",
      "high_label": "Mastery",
      "weight": 1.0,
      "sort_order": 5
    },
    {
      "key": "d6_cultural_fluency",
      "name": "Cultural Fluency",
      "description": "Measures the leader's specific understanding of cultural norms in their target APAC market.",
      "low_label": "Developing",
      "high_label": "Mastery",
      "weight": 1.0,
      "sort_order": 6
    }
  ],
  "archetypes": [
    {
      "key": "the_envoy",
      "name": "The Envoy",
      "description": "Great on paper, fails in practice because relationships don't form. The mandate dies from isolation.",
      "key_traits": [
        "Clear mandate understanding",
        "Strong communication skills",
        "Good pressure resilience"
      ],
      "sort_order": 1
    },
    {
      "key": "the_wanderer",
      "name": "The Wanderer",
      "description": "Misunderstands what the role actually requires. Misaligned expectations create early friction.",
      "key_traits": [
        "Strong stakeholder relationship capability",
        "Good cultural adaptation",
        "Resilient under pressure"
      ],
      "sort_order": 2
    },
    {
      "key": "the_chameleon",
      "name": "The Chameleon",
      "description": "Says all the right things in the wrong way. Message is right but delivery creates friction.",
      "key_traits": [
        "Good mandate understanding",
        "Strong stakeholder relationships",
        "Resilient under pressure"
      ],
      "sort_order": 3
    },
    {
      "key": "the_anchor",
      "name": "The Anchor",
      "description": "Starts strong, deteriorates under sustained pressure. The mandate doesn't fail in good times — it fails in the first crisis.",
      "key_traits": [
        "Clear mandate understanding",
        "Good communication and relationship skills",
        "Strong cultural fluency"
      ],
      "sort_order": 4
    },
    {
      "key": "the_sprinter",
      "name": "The Sprinter",
      "description": "Wins short-term results but burns long-term relationship capital.",
      "key_traits": [
        "Strong delivery and execution capability",
        "Good pressure resilience",
        "Clear communication"
      ],
      "sort_order": 5
    },
    {
      "key": "the_cultural_operator",
      "name": "The Cultural Operator",
      "description": "The ideal BRIDGE profile. Strong across all dimensions with cultural fluency as a demonstrated strength.",
      "key_traits": [
        "Balanced capability across all six mandate dimensions",
        "Cultural fluency as a demonstrated strength",
        "Genuine mutual cross-cultural relationships"
      ],
      "sort_order": 6
    }
  ],
