  },
  "dimensions": [
    {
      "key": "d1_brand_clarity",
      "name": "Brand Clarity",
      "description": "How clearly defined and articulated your professional brand identity is — do you know what you stand for and can you articulate it?",
      "low_label": "Developing",
      "high_label": "Mastery",
      "weight": 1.0,
      "sort_order": 1
    },
    {
      "key": "d2_market_legibility",
      "name": "Market Legibility",
      "description": "How easily your target audience can understand what you do, what value you offer, and where you fit in the market.",
      "low_label": "Developing",
      "high_label": "Mastery",
      "weight": 1.0,
      "sort_order": 2
    },
    {
      "key": "d3_identity_consistency",
      "name": "Identity Consistency",
      "description": "How consistent your brand is across channels, contexts, and interactions — does your LinkedIn match your in-person presence match your work output?",
      "low_label": "Developing",
      "high_label": "Mastery",
      "weight": 1.0,
      "sort_order": 3
    },
    {
      "key": "d4_narrative_power",
      "name": "Narrative Power",
      "description": "How compelling and memorable your professional story is — can you communicate your value in a way that resonates and sticks?",
      "low_label": "Developing",
      "high_label": "Mastery",
      "weight": 1.0,
      "sort_order": 4
    },
    {
      "key": "d5_visibility_level",
      "name": "Visibility Level",
      "description": "How visible you are to your target audience — both in terms of presence in relevant spaces and recognition for your expertise.",
      "low_label": "Developing",
      "high_label": "Mastery",
      "weight": 1.0,
      "sort_order": 5
    }
  ],
  "archetypes": [
    {
      "key": "the_authority",
      "name": "The Authority",
      "description": "Established expert with a clear, consistent brand that's widely recognized in their field.",
      "key_traits": [
        "Credibility",
        "Recognition",
        "Market position"
      ],
      "sort_order": 1
    },
    {
      "key": "the_signal",
      "name": "The Signal",
      "description": "Highly visible professional whose brand cuts through the noise, though the message may be scattered.",
      "key_traits": [
        "Visibility",
        "Reach",
        "Ability to get attention"
      ],
      "sort_order": 2
    },
    {
      "key": "the_monument",
      "name": "The Monument",
      "description": "Well-known but with a brand that feels dated, static, or misaligned with current goals.",
      "key_traits": [
        "Name recognition",
        "Track record"
      ],
      "sort_order": 3
    },
    {
      "key": "the_chameleon",
      "name": "The Chameleon",
      "description": "Adaptable professional with a strong but context-dependent brand — fits in everywhere but lacks a distinct signature.",
      "key_traits": [
        "Adaptability",
        "Cross-context fit",
        "Likability"
      ],
      "sort_order": 4
    },
    {
      "key": "the_amplifier",
      "name": "The Amplifier",
      "description": "Solid professional brand with good visibility and growing clarity — on the cusp of breaking through.",
      "key_traits": [
        "Momentum",
        "Balanced profile",
        "Growth trajectory"
      ],
      "sort_order": 5
    },
    {
      "key": "the_operator",
      "name": "The Operator",
      "description": "Competent behind-the-scenes operator whose brand doesn't match their actual capability.",
      "key_traits": [
        "Substance",
        "Delivery",
        "Results"
      ],
      "sort_order": 6
    },
    {
      "key": "the_ghost",
      "name": "The Ghost",
      "description": "Clear, consistent brand that almost no one sees — high substance, low visibility.",
      "key_traits": [
        "Clarity",
        "Consistency",
        "Authenticity"
      ],
      "sort_order": 7
    },
    {
      "key": "the_mask",
      "name": "The Mask",
      "description": "Professional whose public persona feels like a performance — careful, controlled, but not fully authentic.",
      "key_traits": [
        "Polish",
        "Professionalism",
        "Risk avoidance"
      ],
      "sort_order": 8
    },
    {
      "key": "the_static",
      "name": "The Static",
      "description": "Brand is scattered and hard to see — mixed signals across channels and no clear positioning.",
      "key_traits": [
        "Growth potential",
        "Blank canvas opportunity"
      ],
      "sort_order": 9
    },
    {
      "key": "the_blank_page",
      "name": "The Blank Page",
      "description": "Early-stage professional or career changer who hasn't yet built a defined professional brand.",
      "key_traits": [
        "Fresh start",
        "Unlimited potential"
      ],
      "sort_order": 10
    }
  ],
