# ─────────────────────────────────────────────────────────────────────
# LYC Intelligence — Environment Variables
# Phase 1 / #1288 — Analytics, error monitoring, performance tracking
# ─────────────────────────────────────────────────────────────────────
# Copy this file to .env.local for development, .env.production for prod.

# ── Supabase ──
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Sentry Error Monitoring ──
# Create at https://sentry.io — choose React + Vite platform
VITE_SENTRY_DSN=

# ── PostHog Product Analytics ──
# Create at https://app.posthog.com — Project Settings → API Key
VITE_POSTHOG_KEY=

# ── App Release Tag (for Sentry + analytics) ──
# Set to the git SHA or semantic version in CI
VITE_APP_RELEASE=dev

# ── Server-only (never prefixed with VITE_) ──
# Supabase service role key — used in API routes only
SUPABASE_SERVICE_ROLE_KEY=

# Cron / API auth secret for RLS deployment endpoint
CRON_SECRET=

# Stripe (server-side, API routes only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# DeepSeek / LLM API (server-side, NEXUS chat)
DEEPSEEK_API_KEY=
