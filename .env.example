# ─────────────────────────────────────────────────────────────────────────────
# LYC Intelligence — Environment Variables
# W4-6 / #1291 — Security audit: document all env vars + exposure level.
#
# Copy this file to `.env` (dev) or set in Vercel project settings (prod).
# NEVER commit real secrets. Only VITE_-prefixed vars reach the client bundle.
# ─────────────────────────────────────────────────────────────────────────────

# ── CLIENT-SAFE (exposed in built JS bundle — public/non-secret) ─────────────
# Supabase public keys (safe — anon key is designed to be public)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_KEY=

# Feature flags (safe)
VITE_ENABLE_PLATFORM=
VITE_ENABLE_ADMIN_PREVIEW=

# Monitoring DSNs (safe — DSNs are public identifiers, not secret keys)
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_APP_RELEASE=

# Stripe price IDs (safe — Stripe price IDs are public, checkout is verified server-side)
VITE_STRIPE_PRICE_STARTER=
VITE_STRIPE_PRICE_PRO=
VITE_STRIPE_PRICE_EXECUTIVE=
VITE_STRIPE_PRICE_COUNCIL=

# ── SERVER-ONLY SECRETS (never use VITE_ prefix — must stay on the server) ──
# Supabase service role key (FULL DB ACCESS — never expose to client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# DeepSeek API key (server-side NEXUS chat proxy)
DEEPSEEK_API_KEY=

# Coze API (server-side benchmark + B2B chat)
COZE_API_KEY=
COZE_BOT_ID=
COZE_API_ENDPOINT=
COZE_B2B_BOT_ID=
COZE_BENCHMARK_WORKFLOW_ID=

# NEXUS webhook secrets (server-to-server auth)
NEXUS_WEBHOOK_SECRET=
NEXUS_API_SECRET=
NEXUS_WEBHOOK_URL=

# Internal shared secrets (cron, setup, workers)
SETUP_SECRET=
CRON_SECRET=
WORKER_SHARED_SECRET=
SENDCLOUD_WEBHOOK_SECRET=

# Data residency
PIPL_DATA_RESIDENCY_MODE=

# ── DEPRECATED / DO NOT USE (client-bundle leak risk) ────────────────────────
# These were previously VITE_-prefixed but MUST NOT be set as VITE_ vars:
#   VITE_DEEPSEEK_API_KEY  — use DEEPSEEK_API_KEY instead (server-only)
#   VITE_COZE_API_KEY      — use COZE_API_KEY instead (server-only)
#   VITE_SUPABASE_SERVICE_ROLE_KEY — use SUPABASE_SERVICE_ROLE_KEY instead
# ─────────────────────────────────────────────────────────────────────────────
