+
+  it('allows b2c user_type through (200 via legacy handler)', async () => {
+    const r = res();
+    await handleB2c(req({ method: 'POST', path: ['b2c', 'chat'] }) as never, r as never);
+    expect(r.statusCode).toBe(200);
+    expect(handleNexusChat).toHaveBeenCalledTimes(1);
