+});
+
+describe('b2c router — chat routing', () => {
+  it('POST /b2c/chat → handleNexusChat with req.query.path=["chat"]', async () => {
+    const rr = req({ method: 'POST', path: ['b2c', 'chat'] }) as { query: { path: unknown[] } };
+    const r = res();
